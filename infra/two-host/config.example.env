# Copy this file to infra/.local/tes-151.env and replace every documentation
# value. The setup scripts source that trusted local file. Never commit it.
K3S_VERSION=v1.36.4+k3s1
CONTROL_NODE_NAME=control-1
GAME_NODE_NAME=game-1
CONTROL_PRIVATE_ADDRESS=192.0.2.10
GAME_PRIVATE_ADDRESS=192.0.2.20
CONTROL_API_CLIENT_CIDR=192.0.2.30/32
CONTROL_API_PORT=3000
GAME_PORT=25565

# Data paths must stay below /var/lib/cloud/ so reset-host.sh has a narrow,
# auditable deletion boundary.
POSTGRES_DATA_PATH=/var/lib/cloud/tes-151/postgres
GAME_DATA_PATH=/var/lib/cloud/tes-151/minecraft
POSTGRES_STORAGE_GIB=10
GAME_STORAGE_GIB=10

# Runtime memory and storage are deliberately separate settings. The PVC size
# is an allocation request, not an enforced filesystem quota.
GAME_CPU=2
GAME_JAVA_HEAP=2G
GAME_MEMORY=3Gi
GAME_HOST_RESERVED_CPU=2
GAME_HOST_RESERVED_MEMORY_GIB=4
GAME_HOST_RESERVED_DISK_GIB=10

# The operator must change FALSE to TRUE after accepting the Minecraft EULA.
MINECRAFT_EULA=FALSE

# Generate new values owned by the operator. Each must be at least 20 bytes.
POSTGRES_PASSWORD=replace-me
CLOUD_MACHINE_TOKEN=replace-me

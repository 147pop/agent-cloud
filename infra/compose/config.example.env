# Copy this file to .env and replace both placeholders with operator-owned values.
CLOUD_MACHINE_TOKEN=replace-with-at-least-20-byte-token
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
MINECRAFT_EULA=TRUE

# Optional loopback ports.
CONTROL_API_PORT=3000
GAME_PORT=25565

# Free space required on the world filesystem before creating a server.
STORAGE_MIN_FREE_MIB=2048

# The game is reachable only from this computer by default. To expose it on a
# LAN, set a specific host interface address (not 0.0.0.0); cloud-control
# reports it as the game endpoint. Verify that exposure separately.
GAME_BIND_ADDRESS=127.0.0.1
